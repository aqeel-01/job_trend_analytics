# Job Market Intelligence Pipeline — environment configuration
# Copy to .env and adjust as needed.

# Runtime environment name
JOB_MARKET_ENVIRONMENT=development

# Logging
JOB_MARKET_LOG_LEVEL=INFO
# JOB_MARKET_LOG_FILE=logs/pipeline.log

# SQLite database file path (relative to project root or absolute)
JOB_MARKET_DATABASE_PATH=data/job_market.db

# Ingestion (Arbeitnow)
JOB_MARKET_ARBEITNOW_API_BASE_URL=https://www.arbeitnow.com/api/job-board-api
# JOB_MARKET_INGEST_DEFAULT_MAX_PAGES=1
